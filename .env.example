NEXT_PUBLIC_URL=https://your-mediawiki-domain.de
NEXT_TELEMETRY_DISABLED=1
# Per-machine IP for deploy scripts (bin/build_and_transfer_*.sh).
IP_ADDRESS=192.0.2.1
# Optional. Docker extra_hosts IP if the Next.js container cannot reach
# MediaWiki via IP_ADDRESS (internal docker-network IP, e.g. 10.10.14.210).
# EXTRA_HOST_IP=10.10.14.210
# Wiki instances for ?live=live|prod|test.
API_URL_LIVE=https://sta.dnb.de
API_URL_PROD=https://edit.sta.dnb.de
API_URL_TEST=http://lab.sta.dnb.de
# Host-side tools (npm run solr:index, npm run dev) talk to Solr on localhost.
# Docker Next.js overrides this to the compose service name "solr".
SOLR_HOST=localhost
SOLR_PORT=8983
