NEXT_PUBLIC_URL=https://your-mediawiki-domain.de
# Optional override for server-side Wikibase HTTP (not exposed to the browser).
# Default: http://<public-host> derived from NEXT_PUBLIC_URL / API_URL_* (see lib/env.ts).
# Host-side npm run data:fetch against local MediaWiki: MEDIAWIKI_FETCH_URL=http://127.0.0.1:8080
#
# Browser calls the editor API same-origin via Next rewrite (sibling to /doc):
#   /doc-backend/api/* → EDITOR_API_UPSTREAM (WildFly /sta-doc-api/api/*)
NEXT_PUBLIC_EDITOR_API_URL=/doc-backend/api
# Server-side BFF and next.config rewrite target (absolute URL to WildFly)
EDITOR_API_URL=http://localhost:8080/sta-doc-api/api
EDITOR_API_UPSTREAM=http://localhost:8080/sta-doc-api/api
NEXT_TELEMETRY_DISABLED=1
IP_ADDRESS=192.0.2.1
API_URL_LIVE=http://sta.dnb.de
API_URL_PROD=http://edit.sta.dnb.de
API_URL_TEST=http://lab.sta.dnb.de
SOLR_HOST=localhost
SOLR_PORT=8983

# --- Editor / Postgres migration (default: legacy / off) ---
# Production: omit or set to false — sta-doc behaves like pre-editor (data/parsed only).
# Local pilot / dev: enable both for Sprint 1½ smoke tests.
NEXT_PUBLIC_STA_EDITOR_ENABLED=true
NEXT_PUBLIC_STA_POSTGRES_READ_ENABLED=true
STA_POSTGRES_READ_ENABLED=true
