NEXT_PUBLIC_URL=https://your-mediawiki-domain.de
# Server-side Wikibase HTTP base when co-located with MediaWiki (not exposed to the browser).
# Docker on dnb-wikibase_default: http://mediawiki.svc
# Host-side npm run data:fetch: http://127.0.0.1:8080
# MEDIAWIKI_FETCH_URL=http://mediawiki.svc
NEXT_TELEMETRY_DISABLED=1
IP_ADDRESS=192.0.2.1
API_URL_LIVE=http://sta.dnb.de
API_URL_PROD=http://edit.sta.dnb.de
API_URL_TEST=http://lab.sta.dnb.de
SOLR_HOST=localhost
SOLR_PORT=8983
