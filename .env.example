NEXT_PUBLIC_URL=https://your-mediawiki-domain.de
NEXT_TELEMETRY_DISABLED=1
# Per-machine IP of the MediaWiki host in NEXT_PUBLIC_URL.
# Used by Docker extra_hosts and by bin/build_and_transfer_*.sh.
IP_ADDRESS=192.0.2.1
# Host-side tools (npm run solr:index, npm run dev) talk to Solr on localhost.
# Docker Next.js overrides this to the compose service name "solr".
SOLR_HOST=localhost
SOLR_PORT=8983
