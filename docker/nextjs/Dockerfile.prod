FROM node:20-alpine AS dev-stage

# Install build dependencies only for development
RUN apk add --no-cache python3 make g++ git
WORKDIR /srv
COPY ./package*.json ./.npmrc ./
RUN npm install
COPY . .

# Build stage
FROM dev-stage AS build-stage

# Set environment variables
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}
ENV NODE_OPTIONS=--max_old_space_size=4096
ENV basePath="/doc"

RUN npm run build
# npm ci wipes node_modules itself and installs exactly what the lockfile pins,
# so the runtime tree matches what `.next/node_modules` symlinks were built against.
RUN npm ci --omit=dev

# Production stage
FROM node:20-alpine AS production-stage

# Install minimal runtime dependencies
RUN apk add --no-cache git

# Set environment variables
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}
ENV basePath="/doc"

WORKDIR /srv
COPY --from=build-stage /srv /srv

CMD ["npm", "start"]